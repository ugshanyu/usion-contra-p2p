# No server-side env vars needed!
# This is a pure client-side P2P game.
# All configuration comes from the Usion SDK at runtime.
#
# The Usion backend provides:
# - ICE servers (STUN + TURN) for NAT traversal
# - Room info (host_id, player_ids) for role detection
# - Socket.IO connection for signaling relay
#
# For local development without Usion SDK, the game falls back to
# public STUN servers (works on localhost, not across networks).

# Server port (for Next.js static serving)
PORT=3012
